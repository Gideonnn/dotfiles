# This file is PUBLIC (github.com/Gideonnn/dotfiles). Keep it free of host
# names, IP addresses, tailnet names and account names.
#
# Machine-specific hosts live in .ssh-config next to this file, which is
# gitignored and pulled in by the Include below. ssh takes the FIRST value
# it sees for any setting, so the Include comes first: a host block in the
# personal file wins over the generic `Host *` block here.
#
# A missing .ssh-config is not an error -- ssh skips an Include it cannot
# read -- so a fresh machine works before that file exists.
Include ~/git/dotfiles/.ssh-config

Host *
  AddKeysToAgent yes
  IgnoreUnknown UseKeychain
  UseKeychain yes

Host github.com
  HostName github.com
  IdentityFile ~/.ssh/id_ed25519

Host ssh.dev.azure.com
  HostName ssh.dev.azure.com
  IdentityFile ~/.ssh/rsa_glaspoort
