#!/usr/bin/env bash
set -euo pipefail

# Turn a recording (or an existing transcript) into meeting notes:
# transcribes via OpenAI, then writes a Dutch Markdown summary + action points.
#
# The summary is generated by your local Claude CLI (uses your Claude
# subscription, no extra API cost). Transcription still goes through OpenAI.
#
# Usage:  meet-notes [-d|--diarize] [-t|--tools] <audio-file | transcript.txt>
# Writes: <name>.txt   (transcript, if input was audio)
#         <name>.md    (samenvatting + besluiten + actiepunten)
#
# Flags:
#   -d, --diarize   label speakers during transcription (~2.5x STT cost)
#   -t, --tools     give Claude read-only access to the recording's folder and,
#                   when you are inside a git repo, that repo -- so it can check
#                   terminology, names and context
#
# Env:
#   MEET_SUMMARY_BACKEND  claude (default) | openai
#   MEET_SUMMARY_MODEL    openai backend: chat model (default: gpt-4o-mini)
#   MEET_CONTEXT_DIR      repo the -t flag grants read access to
#   MEET_LANG / MEET_STT_MODEL  passed through to meet-transcribe
#   OPENAI_API_KEY        required for transcription (and the openai backend)

meet_bin="$(cd "$(dirname "$0")" && pwd -P)"
. "${meet_bin}/meet-lib.sh"

MEET_SUMMARY_BACKEND="${MEET_SUMMARY_BACKEND:-claude}"
MEET_SUMMARY_MODEL="${MEET_SUMMARY_MODEL:-gpt-4o-mini}"

# Leading flags in any order: -d → diarize (inherited by meet-transcribe),
# -t → let Claude read the recording folder + repo.
while [ $# -gt 0 ]; do
  case "${1:-}" in
    -d|--diarize) export MEET_DIARIZE=1; shift ;;
    -t|--tools)   export MEET_NOTES_TOOLS=1; shift ;;
    *) break ;;
  esac
done

meet_load_env

input="${1:?Usage: meet-notes [-d] [-t] <audio-file | transcript.txt>}"
[ -f "$input" ] || { echo "No such file: $input" >&2; exit 1; }

base="${input%.*}"
folder="$(cd "$(dirname "$input")" && pwd -P)"
# Resolved from the recording's own folder, so notes regenerated from anywhere
# still pick up the repo the meeting belongs to.
context="$(cd "$folder" && meet_context_dir)"

# If given audio, transcribe first (OpenAI); if given a .txt, use it as-is.
if [ "${input##*.}" = "txt" ]; then
  txt="$input"
else
  "${meet_bin}/meet-transcribe" "$input"
  txt="${base}.txt"
fi

md="${base}.md"

read -r -d '' SYS <<'PROMPT' || true
Je bent een assistent die van een letterlijke vergadertranscriptie beknopte
notulen maakt. Antwoord uitsluitend in het Nederlands en uitsluitend in Markdown,
zonder inleidende of afsluitende tekst. Gebruik exact deze secties (in deze volgorde):

## Samenvatting
Drie tot zes zinnen die de kern van het gesprek weergeven.

## Besluiten
Opsomming van genomen besluiten. Laat de sectie weg als er geen besluiten zijn.

## Actiepunten
Opsomming als checklist. Formaat per punt:
- [ ] {actie} — {eigenaar indien genoemd} — {deadline indien genoemd}
Laat eigenaar of deadline weg als die niet genoemd is. Laat de sectie weg als er
geen acties zijn.

## Open vragen
Onbeantwoorde vragen of openstaande discussiepunten. Laat weg indien niet van toepassing.

De transcriptie kan sprekerlabels bevatten (bijv. "A:" of "speaker_1:"); gebruik
die om acties en uitspraken aan de juiste persoon toe te schrijven waar dat kan.
Baseer je uitsluitend op de transcriptie. Verzin geen namen, besluiten of acties.
PROMPT

if [ "$MEET_SUMMARY_BACKEND" = "openai" ]; then
  meet_require_key
  transcript="$(cat "$txt")"
  payload="$(jq -n \
    --arg model "$MEET_SUMMARY_MODEL" \
    --arg sys "$SYS" \
    --arg usr "$transcript" \
    '{model: $model,
      messages: [
        {role: "system", content: $sys},
        {role: "user", content: ("Transcriptie:\n\n" + $usr)}
      ],
      temperature: 0.2}')"

  echo "⏳ Samenvatting genereren via OpenAI (${MEET_SUMMARY_MODEL}) ..."
  if resp="$(curl -sS --fail-with-body https://api.openai.com/v1/chat/completions \
        -H "Authorization: Bearer ${OPENAI_API_KEY}" \
        -H "Content-Type: application/json" \
        -d "$payload")"; then
    printf '%s\n' "$resp" | jq -r '.choices[0].message.content' > "$md"
    echo "✅ Notulen: ${md}"
  else
    echo "OpenAI API error:" >&2; printf '%s\n' "$resp" >&2; exit 1
  fi
else
  # Local Claude CLI — uses your Claude subscription. The transcript is piped
  # in on stdin; the section spec lives in the system prompt.
  command -v claude >/dev/null || { echo "claude CLI not found on PATH." >&2; exit 1; }
  args=( -p "De volledige vergadertranscriptie staat hieronder (via stdin). Maak de notulen."
         --append-system-prompt "$SYS"
         --output-format text )
  if [ "${MEET_NOTES_TOOLS:-}" = "1" ]; then
    args+=( --add-dir "$folder" )
    if [ -n "$context" ] && [ "$context" != "$folder" ]; then
      args+=( --add-dir "$context" )
      echo "⏳ Samenvatting genereren via lokale Claude (met leestoegang tot ${folder} en ${context}) ..."
    else
      echo "⏳ Samenvatting genereren via lokale Claude (met leestoegang tot ${folder}) ..."
    fi
    args+=( --allowed-tools Read Grep Glob )
  else
    echo "⏳ Samenvatting genereren via lokale Claude ..."
  fi
  if claude "${args[@]}" < "$txt" > "$md"; then
    echo "✅ Notulen: ${md}"
  else
    echo "Claude CLI error." >&2; exit 1
  fi
fi
