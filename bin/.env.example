# Copy to .env (gitignored) and paste your OpenAI API key.
# Used for transcription (and the optional openai summary backend).
# Get one at https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-...

# Optional overrides:
# MEET_DIR=~/meetings          # where dated meeting folders are created
# MEET_DEVICE=Meet Input       # avfoundation input name
# MEET_LANG=nl                 # transcription language hint
